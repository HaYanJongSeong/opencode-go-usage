+import { expect, test } from "bun:test"
+import { createRoot } from "solid-js"
+import { createQuotaController, formatQuotaReset, parseQuotaSnapshot, QuotaSnapshot } from "./quota"
+
+const snapshot = {
+  checkedAt: "2026-10-13T12:00:00Z",
+  go: { label: "Go", checkedAt: "2026-10-13T12:00:00Z", windows: [{ name: "Weekly", usedPercent: 17.5, remainingPercent: 82.5, resetsAt: null }] },
+  codex: { label: "Codex", checkedAt: "2026-10-13T12:00:00Z", error: { code: "unavailable", message: "private server detail" } },
+} satisfies typeof QuotaSnapshot.Type
+
+test("quota reset formats missing, invalid, past and minute/hour/day boundaries", () => {
+  const now = Date.parse("2026-10-13T12:00:00Z")
+  for (const [input, key, days, hours, minutes] of [
+    [null, "quota.resetMissing", 0, 0, 0],
+    ["invalid", "quota.resetMissing", 0, 0, 0],
+    ["2026-10-13T11:00:00Z", "quota.resetDue", 0, 0, 0],
+    ["2026-10-13T12:00:59Z", "quota.resetSoon", 0, 0, 0],
+    ["2026-10-13T12:01:00Z", "quota.resetHours", 0, 0, 1],
+    ["2026-10-13T12:59:59Z", "quota.resetHours", 0, 0, 59],
+    ["2026-10-13T13:00:00Z", "quota.resetHours", 0, 1, 0],
+    ["2026-10-13T14:10:00Z", "quota.resetHours", 0, 2, 10],
+    ["2026-10-14T12:00:00Z", "quota.resetHours", 1, 24, 0],
+    ["2026-10-15T15:10:00Z", "quota.resetHours", 2, 51, 10],
+  ] as const) {
+    const result = formatQuotaReset(input, now)
+    expect(result.key).toBe(key)
+    expect(result.params).toEqual({ days, hours, minutes })
+  }
+})
+
+test("quota validates actual percentages, nullable resets and partial errors", () => {
+  expect(parseQuotaSnapshot(snapshot)).toEqual(snapshot)
+  for (const value of [-1, 101, NaN, Infinity, "82.5"]) {
+    expect(() => parseQuotaSnapshot({ ...snapshot, go: { ...snapshot.go, windows: [{ ...snapshot.go.windows[0], remainingPercent: value }] } })).toThrow()
+  }
+  expect(() => parseQuotaSnapshot({ ...snapshot, go: { ...snapshot.go, error: snapshot.codex.error } })).toThrow()
+  expect(() => parseQuotaSnapshot({ ...snapshot, go: { ...snapshot.go, windows: [] } })).toThrow()
+})
+test("only the official Go idle-window state is labelled starts on first use", () => {
+  expect(formatQuotaReset(null, Date.now(), true).key).toBe("quota.resetStartsOnUse")
+  expect(formatQuotaReset(null, Date.now()).key).toBe("quota.resetMissing")
+  expect(formatQuotaReset("invalid", Date.now(), true).key).toBe("quota.resetMissing")
+})
+
