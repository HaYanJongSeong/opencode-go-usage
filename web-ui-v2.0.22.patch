+import { createEffect, createSignal, For, onCleanup, Show } from "solid-js"
+import { Button } from "@opencode/ui/button"
+import { Progress } from "@opencode/ui/progress"
+import { useLanguage } from "@/runtime/i18n/language"
+import type { QuotaController } from "./quota"
+import { formatQuotaReset } from "./quota"
+import "./quota-panel.css"
+
+export function QuotaPanel(props: { quota: QuotaController }) {
+  const language = useLanguage()
+  const [now, setNow] = createSignal(Date.now())
+  createEffect(() => {
+    if (!props.quota.state.visible) return
+    setNow(Date.now())
+    const interval = setInterval(() => setNow(Date.now()), 60_000)
+    onCleanup(() => clearInterval(interval))
+  })
+  return (
+    <Show when={props.quota.state.visible}>
+      <section
+        class="composer-quota flex min-w-0 flex-col gap-2 text-12-regular"
+        aria-label={language.t("quota.title")}
+      >
+        <div class="flex items-center justify-between gap-2">
+          <span>{language.t("quota.title")}</span>
+          <div class="flex items-center gap-2">
+            <Button
+              variant="ghost"
+              size="small"
+              disabled={props.quota.state.loading}
+              onClick={() => void props.quota.refresh()}
+            >
+              {language.t("quota.refresh")}
+            </Button>
+            <Button variant="outline" size="normal" class="composer-quota-close" onClick={() => props.quota.close()}>
+              {language.t("quota.close")}
+            </Button>
+          </div>
+        </div>
+        <div role="status" aria-live="polite">
+          <Show when={props.quota.state.loading}>{language.t("quota.loading")}</Show>
+          <Show when={props.quota.state.error}>
+            {(error) => language.t(error() === "arguments" ? "quota.arguments" : "quota.unavailable")}
+          </Show>
+        </div>
+        <Show when={props.quota.state.snapshot}>
+          {(snapshot) => (
+            <For each={[snapshot().go, snapshot().codex]}>
+              {(section) => (
+                <div class="flex min-w-0 flex-col gap-2">
+                  <span>{section.label}</span>
+                  <Show
+                    when={"windows" in section ? section.windows : undefined}
+                    fallback={
+                      <span role="status">
+                        {language.t(
+                          "error" in section && section.error.code === "auth"
+                            ? section.label === "Go"
+                              ? "quota.connectGo"
+                              : "quota.connectOpenAI"
+                            : "quota.unavailable",
+                        )}
+                      </span>
+                    }
+                  >
+                    {(windows) => (
+                      <div class="flex flex-col gap-2">
+                        <For each={windows()}>
+                          {(window) => {
+                             const reset = () => formatQuotaReset(window.resetsAt, now(), section.label === "Go" && window.name === "5h")
+                            return (
+                              <Progress value={window.remainingPercent} minValue={0} maxValue={100}>
+                                <span class="composer-quota-label-row">
+                                  <span class="composer-quota-remaining">
+                                    {language.t("quota.remaining", { name: window.name, percent: window.remainingPercent })}
+                                  </span>
+                                  <span class="composer-quota-reset text-text-weak">
+                                    {language.t(reset().key, reset().params)}
+                                  </span>
+                                </span>
+                              </Progress>
+                            )
+                          }}
+                        </For>
+                      </div>
+                    )}
+                  </Show>
+                </div>
+              )}
+            </For>
+          )}
+        </Show>
+      </section>
+    </Show>
+  )
+}
