+import { Schema } from "effect"
+import { createStore } from "solid-js/store"
+import { onCleanup } from "solid-js"
+import { QuotaRpc } from "./quota-rpc.mjs"
+import { parseQuotaCommand } from "./client-slash-command"
+
+const percent = Schema.Number.check(Schema.isFinite(), Schema.isBetween({ minimum: 0, maximum: 100 }))
+const window = Schema.Struct({
+  name: Schema.String,
+  usedPercent: percent,
+  remainingPercent: percent,
+  resetsAt: Schema.NullOr(Schema.String),
+})
+const fields = { label: Schema.String, checkedAt: Schema.String }
+const section = Schema.Union([
+  Schema.Struct({ ...fields, windows: Schema.NonEmptyArray(window) }),
+  Schema.Struct({ ...fields, error: Schema.Struct({ code: Schema.String, message: Schema.String }) }),
+])
+export const QuotaSnapshot = Schema.Struct({ checkedAt: Schema.String, go: section, codex: section })
+export const parseQuotaSnapshot = Schema.decodeUnknownSync(QuotaSnapshot, { onExcessProperty: "error" })
+export { QuotaRpc }
+
+export function formatQuotaReset(resetsAt: string | null, now: number, startsOnFirstUse = false) {
+  if (resetsAt === null && startsOnFirstUse) return { key: "quota.resetStartsOnUse" as const, params: { days: 0, hours: 0, minutes: 0 } }
+  const reset = resetsAt === null ? NaN : Date.parse(resetsAt)
+  if (!Number.isFinite(reset)) return { key: "quota.resetMissing" as const, params: { days: 0, hours: 0, minutes: 0 } }
+  const minutes = Math.floor(Math.max(0, reset - now) / 60_000)
+  const params = { days: Math.floor(minutes / 1440), hours: Math.floor(minutes / 60), minutes: minutes % 60 }
+  if (reset <= now) return { key: "quota.resetDue" as const, params }
+  if (minutes < 1) return { key: "quota.resetSoon" as const, params }
+  return { key: "quota.resetHours" as const, params }
+}
+
+export function createQuotaController(read: (signal: AbortSignal) => Promise<unknown>) {
+  const [state, setState] = createStore<{
+    visible: boolean
+    loading: boolean
+    snapshot?: typeof QuotaSnapshot.Type
+    error?: "arguments" | "unavailable"
+  }>({ visible: false, loading: false })
+  let pending: AbortController | undefined
+  onCleanup(() => pending?.abort())
+
+  const refresh = async () => {
+    pending?.abort()
+    const request = new AbortController()
+    pending = request
+    setState({ visible: true, loading: true, snapshot: undefined, error: undefined })
+    try {
+      const snapshot = parseQuotaSnapshot(await read(request.signal))
+      if (request.signal.aborted) return
+      setState({ snapshot, loading: false })
+    } catch {
+      if (request.signal.aborted) return
+      setState({ error: "unavailable", loading: false })
+    }
+  }
+  return {
+    state,
+    refresh,
+    close() {
+      pending?.abort()
+      pending = undefined
+      setState({ visible: false, loading: false, snapshot: undefined, error: undefined })
+    },
+    command(text: string) {
+      const parsed = parseQuotaCommand(text)
+      if (!parsed) return
+      return () => {
+        if (parsed.valid) {
+          void refresh()
+          return
+        }
+        pending?.abort()
+        setState({ visible: true, loading: false, snapshot: undefined, error: "arguments" })
+      }
+    },
+  }
+}
+
+export type QuotaController = ReturnType<typeof createQuotaController>
